{
  "204-01": "想象一条扫描线，从左向右移动。",
  "204-02": [
    "遇到竖直线段时，线段上的点有相同的",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标。"
  ],
  "204-03": "能不能把它稍微推斜？这一集，先理解剪切怎样改变坐标。",
  "204-04": [
    "固定坐标轴。取",
    {
      "text": "系数",
      "pinyin": "xi4 shu4"
    },
    "二分之一，点 P 的",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标和纵坐标都是二。"
  ],
  "204-05": [
    "先把纵坐标",
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    "以",
    {
      "text": "系数",
      "pinyin": "xi4 shu4"
    },
    "：二分之一",
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    "二，",
    {
      "text": "得到",
      "pinyin": "de2 dao4"
    },
    "一。"
  ],
  "204-06": [
    "把一加到原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标二上，新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标就是三。"
  ],
  "204-07": [
    "纵坐标仍",
    {
      "text": "为",
      "pinyin": "wei2"
    },
    "二。向右移动一，",
    {
      "text": "得到",
      "pinyin": "de2 dao4"
    },
    "新点 P ",
    {
      "text": "撇",
      "pinyin": "pie3"
    },
    "。"
  ],
  "204-08": [
    "一般地，新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标等于原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标，加上",
    {
      "text": "系数",
      "pinyin": "xi4 shu4"
    },
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    "原纵坐标。"
  ],
  "204-09": "新纵坐标等于原纵坐标，所以点只沿水平方向移动。",
  "204-10": [
    "s 叫剪切",
    {
      "text": "系数",
      "pinyin": "xi4 shu4"
    },
    "。s ",
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    " y，这次取二分之一",
    {
      "text": "只为",
      "pinyin": "zhi3 wei4"
    },
    "图解。"
  ],
  "204-11": [
    "字母右上方的",
    {
      "text": "撇",
      "pinyin": "pie3"
    },
    "号，只是",
    {
      "text": "区分",
      "pinyin": "qu1 fen1"
    },
    "新旧的记号，不是新的运算。"
  ],
  "204-12": [
    "点 Q 的",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标和纵坐标都是负一。它往哪边走？新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标是多少？"
  ],
  "204-13": [
    "把负一代入公式，先算二分之一",
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    "负一。"
  ],
  "204-14": [
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    "积是负二分之一，所以要从负一再减去二分之一。"
  ],
  "204-15": [
    "负一写成负二分之二，相减",
    {
      "text": "得到",
      "pinyin": "de2 dao4"
    },
    "负二分之三。"
  ],
  "204-16": [
    "纵坐标仍",
    {
      "text": "为",
      "pinyin": "wei2"
    },
    "负一。点向左移动二分之一，",
    {
      "text": "得到",
      "pinyin": "de2 dao4"
    },
    " Q ",
    {
      "text": "撇",
      "pinyin": "pie3"
    },
    "。"
  ],
  "205-01": "现在换一种操作。回到原来的 P，固定它的位置，不再移动点。",
  "205-02": [
    "保留水平",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "轴，改用向左倾斜的纵轴。点 P 与原点都不动。"
  ],
  "205-03": [
    "过 P 画",
    {
      "text": "平行",
      "pinyin": "ping2 xing2"
    },
    "于新纵轴的线，找到它与",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "轴的交点。"
  ],
  "205-04": [
    "交点在刻度三，所以新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标是三，不能一律作垂线。"
  ],
  "205-05": [
    "再沿新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "轴的",
    {
      "text": "平行",
      "pinyin": "ping2 xing2"
    },
    "方向，读出新纵坐标二。"
  ],
  "205-06": [
    "同一个 P，原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标是二，原纵坐标是二。新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标是三，新纵坐标是二。点没有移动。"
  ],
  "205-07": [
    "坐标下方的标记，说明用哪套轴读数。斜轴刻度不等于沿轴",
    {
      "text": "长度",
      "pinyin": "chang2 du4"
    },
    "。"
  ],
  "206-01": "新旧纵坐标相等，所以把等式反过来写，原纵坐标等于新纵坐标。",
  "206-02": [
    "再看",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标公式。现在已知新坐标，要反过来求原坐标。"
  ],
  "206-03": [
    "因为 y 等于 y ",
    {
      "text": "撇",
      "pinyin": "pie3"
    },
    "，把右边的 y 换成 y ",
    {
      "text": "撇",
      "pinyin": "pie3"
    },
    "。"
  ],
  "206-04": [
    "要单独留下 x，就在等式两边同时减去 s ",
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    " y ",
    {
      "text": "撇",
      "pinyin": "pie3"
    },
    "。"
  ],
  "206-05": "右边加上和减去的是同一个数，它们抵消，只剩下 x。",
  "206-06": [
    "交换等式左右两边，就",
    {
      "text": "得到",
      "pinyin": "de2 dao4"
    },
    "逆变换；纵坐标的等式也一起保留。"
  ],
  "206-07": [
    "把刚才的二换成任意",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标。新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "轴上的点，新纵坐标",
    {
      "text": "为",
      "pinyin": "wei2"
    },
    "零。因此原纵坐标也",
    {
      "text": "为",
      "pinyin": "wei2"
    },
    "零。"
  ],
  "206-08": [
    "把新纵坐标零代入，原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标等于新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标，减去 s ",
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    "零。"
  ],
  "206-09": [
    "任何数",
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    "零都是零，所以原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标等于新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标。"
  ],
  "206-10": [
    "这对任意",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标都成立。新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "轴的位置、方向和刻度，全都不变。"
  ],
  "206-11": [
    "取",
    {
      "text": "系数",
      "pinyin": "xi4 shu4"
    },
    "二分之一。",
    {
      "text": "选中",
      "pinyin": "xuan3 zhong4"
    },
    "新纵轴刻度二的点，它的新纵坐标是二。先只看这个读数。"
  ],
  "206-12": [
    "新纵坐标是二，所以原纵坐标也",
    {
      "text": "为",
      "pinyin": "wei2"
    },
    "二。水平辅助线标出了这个高度。"
  ],
  "206-13": [
    "把新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标零、新纵坐标二和",
    {
      "text": "系数",
      "pinyin": "xi4 shu4"
    },
    "二分之一，代入逆变换。"
  ],
  "206-14": [
    "先",
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    {
      "text": "得到",
      "pinyin": "de2 dao4"
    },
    "一，再从零减去一，原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标就是负一。"
  ],
  "206-15": "从原点向左走一，再向上走二，正好到达这个固定点。",
  "206-16": [
    "更一般地，新纵轴上的点满足新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标",
    {
      "text": "为",
      "pinyin": "wei2"
    },
    "零，所以 x 等于负 s ",
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    " y ",
    {
      "text": "撇",
      "pinyin": "pie3"
    },
    "。"
  ],
  "206-17": [
    "当",
    {
      "text": "系数",
      "pinyin": "xi4 shu4"
    },
    "和新纵坐标都",
    {
      "text": "为",
      "pinyin": "wei2"
    },
    "正数时，原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标",
    {
      "text": "为",
      "pinyin": "wei2"
    },
    "负，点在原纵轴左侧。"
  ],
  "206-18": [
    "因此新纵轴",
    {
      "text": "朝",
      "pinyin": "chao2"
    },
    "左上方倾斜，",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "轴却没有变。这不是整体",
    {
      "text": "旋转",
      "pinyin": "xuan2 zhuan3"
    },
    "。"
  ],
  "206-19": [
    "刻度二代表新纵坐标。它不代表从原点沿斜轴",
    {
      "text": "量",
      "pinyin": "liang2"
    },
    "出的",
    {
      "text": "长度",
      "pinyin": "chang2 du4"
    },
    {
      "text": "为",
      "pinyin": "wei2"
    },
    "二。"
  ],
  "207-01": [
    "P 相对原点一直不动。原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标是二，原纵坐标是二。新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标是三，新纵坐标是二。这是哪种操作？"
  ],
  "207-02": [
    "先对照点移动：坐标轴不变，从 P 向右移动一，画出新点 P ",
    {
      "text": "撇",
      "pinyin": "pie3"
    },
    "。"
  ],
  "207-03": [
    "再对照换坐标系：P 留在原位，沿新轴方向读出新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标三，新纵坐标二。"
  ],
  "207-04": "题目说 P 始终不动，所以改变的是读取坐标的方式。",
  "207-05": [
    "左右都从原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标二、原纵坐标二出发。左边固定坐标轴，画出新点。右边固定 P，",
    {
      "text": "更换",
      "pinyin": "geng1 huan4"
    },
    "读数所用的轴。"
  ],
  "207-06": [
    "最后留下一个问题：剪切",
    {
      "text": "系数",
      "pinyin": "xi4 shu4"
    },
    "能随便选吗？我们下一集继续。"
  ],
  "205-01a": [
    "先读原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标。过 P 画",
    {
      "text": "平行",
      "pinyin": "ping2 xing2"
    },
    "于原纵轴的竖直线，落在",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "轴刻度二。"
  ],
  "205-01b": [
    "再读原纵坐标。过 P 画",
    {
      "text": "平行",
      "pinyin": "ping2 xing2"
    },
    "于原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "轴的水平线，落在纵轴刻度二。"
  ],
  "206-06a": [
    "先看新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "轴刻度二的点。它的新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标是二，新纵坐标是零。"
  ],
  "206-06b": [
    "新旧纵坐标相等，所以原纵坐标也是零。它也在原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "轴上。"
  ],
  "206-06c": [
    "原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标等于二减去 s ",
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    "零。",
    {
      "text": "乘",
      "pinyin": "cheng2"
    },
    "零",
    {
      "text": "得到",
      "pinyin": "de2 dao4"
    },
    "零，所以原",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标仍是二。"
  ],
  "206-06d": [
    "两套坐标都读成",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标二、纵坐标零。这个点的位置和刻度都没有变。"
  ],
  "206-11a": [
    "沿新纵轴的方向回到",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "轴，落点是原点。所以新",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标是零。"
  ],
  "207-05a": [
    "同样算出",
    {
      "text": "横",
      "pinyin": "heng2"
    },
    "坐标三、纵坐标二。左边表示新点的位置，右边表示原来这个点的新读数。先问固定的是坐标轴，还是几何点。"
  ]
}
