{
  "extends": "../../shared/config/tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "types": ["node", "web"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "katex": ["./node_modules/@types/katex"],
