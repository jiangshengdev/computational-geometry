      "endMs": 18938,
      "timestampMs": null,
      "confidence": null,
      "source": 1
    }
  ],
  "TW33": [
    {
      "text": "新块来自本次参与组，r≤h_p；非空时内部至多 r−1 对，两端各至多一对。",
