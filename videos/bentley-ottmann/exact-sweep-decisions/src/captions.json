      "endMs": 17628,
      "timestampMs": null,
      "confidence": null
    }
  ],
  "ES39": [
    {
      "text": "第二章的结论是：右侧高度差的符号，与第二条斜率减第一条斜率相同，左侧相反。",
      "startMs": 70,
      "endMs": 7708,
      "timestampMs": null,
      "confidence": null
    },
    {
