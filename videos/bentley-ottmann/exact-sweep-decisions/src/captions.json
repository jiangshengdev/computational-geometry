      "endMs": 15278,
      "timestampMs": null,
      "confidence": null
    }
  ],
  "ES34": [
    {
      "text": "在开始事件处，新线段端点不落在其他线段上，这是本集已声明的条件。",
      "startMs": 70,
      "endMs": 6388,
      "timestampMs": null,
      "confidence": null
    },
    {
