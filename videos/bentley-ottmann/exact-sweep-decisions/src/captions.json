      "endMs": 14117,
      "timestampMs": null,
      "confidence": null
    }
  ],
  "ES33": [
    {
      "text": "差为正，第二份在第一份上方；差为负，就在下方。",
      "startMs": 70,
      "endMs": 5378,
      "timestampMs": null,
      "confidence": null
